{
  "rewrites": [
    {
      "source": "/payment/callback",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/**/*.js": {
      "includeFiles": "public/{receipt-products/*.png,fonts/*}",
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/emails/worker",
      "schedule": "0 7 * * *"
    }
  ]
}
